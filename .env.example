# Copy to .env for local development. .env is gitignored; never commit real secrets.
#
# Anything marked REQUIRED IN PROD hard-fails startup when DEBUG=False. Under DEBUG=True an
# insecure development fallback is used so a fresh checkout runs with no configuration.

# --- Core -------------------------------------------------------------------

DEBUG=True

# REQUIRED IN PROD. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated. Ignored while DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF on non-local hostnames, e.g. https://confdash.example.org
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------

# The docker-compose stack sets this for the app container. Set it here only when running
# Django directly against a database on the host.
DATABASE_URL=postgres://confdash:confdash@localhost:5432/confdash

# Credentials the compose postgres service initializes itself with.
POSTGRES_DB=confdash
POSTGRES_USER=confdash
POSTGRES_PASSWORD=confdash

# --- Host ports -------------------------------------------------------------

# Override any of these when another project's stack already holds the port. Container-internal
# ports never change, so nothing inside the stack is affected.
APP_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# --- Provider credential encryption ----------------------------------------

# REQUIRED IN PROD. Encrypts ProviderConnection.credentials at rest, so losing this key means
# losing every organization's stored provider credentials. Back it up before going live and
# read plans/provider-integrations.md before rotating.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Email ------------------------------------------------------------------

# Speaker magic links are transactional mail, so the provider matters for deliverability. The
# provider is not baked in: set EMAIL_PROVIDER to any Anymail backend name and confdash uses it.
# Leave it blank and EMAIL_URL applies instead, which is how development reaches mailpit.

# Anymail backend name: mailgun, postmark, sendgrid, brevo, resend, amazon_ses, ...
# Blank for local development.
EMAIL_PROVIDER=

# The provider's API credential; for Mailgun this is the private API key. REQUIRED IN PROD when
# EMAIL_PROVIDER names a provider that needs one. Providers authenticating another way
# (amazon_ses uses boto3 credentials) need nothing here.
EMAIL_API_KEY=

# Mailgun only, optional. Mailgun addresses its send API per domain; left blank, Anymail derives
# the domain from the From address, which is correct when DEFAULT_FROM_EMAIL is already on the
# Mailgun domain. Set it only when the two differ (e.g. a mg.confdash.org sending subdomain).
EMAIL_SENDER_DOMAIN=

# Optional non-default API endpoint, chiefly for regional hosts. Mailgun's EU region is
# https://api.eu.mailgun.net/v3.
EMAIL_API_URL=

# Used only when EMAIL_PROVIDER is blank. Applies when running Django directly on the host;
# inside the compose stack it is overridden to mailpit, which captures all mail for reading at
# http://localhost:8026.
EMAIL_URL=consolemail://

# Fallback sender for organizations that have not set their own. In production this is an address
# on the deployment's sending domain (confdash.org for the PyOhio-hosted instance), which must be
# verified with the provider or mail is rejected.
DEFAULT_FROM_EMAIL=confdash@localhost

# Sender for Django's own error mail, which is operator-facing. Defaults to DEFAULT_FROM_EMAIL.
SERVER_EMAIL=

# Base URL used to build absolute magic-link URLs in email.
SITE_BASE_URL=http://localhost:8000

# --- Observability ----------------------------------------------------------

# Error tracking is off unless a DSN is set. Points at GlitchTip.
SENTRY_DSN=

LOG_LEVEL=INFO
# json in production, console in dev. Defaults to console while DEBUG=True.
LOG_FORMAT=console
